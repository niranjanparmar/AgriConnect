# AgriConnect Environment Variables Configuration Template
# Copy this file to .env and adjust values for your environment

# Flask Core Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-hex-key-in-production

# Database Configuration (PostgreSQL default; fallback to SQLite for immediate local testing)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agriconnect
DATABASE_URL=sqlite:///agriconnect.db

# Upload Configuration
MAX_CONTENT_LENGTH=5242880  # 5MB upload limit
UPLOAD_FOLDER=app/static/uploads

# External Agricultural Price Data API (Demo mode by default)
AGRI_PRICE_API_KEY=
AGRI_PRICE_API_URL=
